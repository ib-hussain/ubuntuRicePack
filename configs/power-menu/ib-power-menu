#!/bin/bash
LOG_FILE="$HOME/.local/state/ubuntuRicePack/logs/power-profiles.log"
mkdir -p "$(dirname "$LOG_FILE")"
echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] Displaying power menu" >> "$LOG_FILE"

while true; do
    echo "=============================="
    echo "   Power Mode Switcher"
    echo "=============================="
    echo "1) Ultra Battery Saver"
    echo "2) Battery Saver"
    echo "3) Balanced"
    echo "4) Performance"
    echo "5) Maximum Performance"
    echo "6) Quit"
    echo ""
    read -r -p "Enter choice (1-6): " choice

    case "$choice" in
        1)
            echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] User selected Ultra Battery Saver" >> "$LOG_FILE"
            sudo ib-power-mode ultrasaver
            ;;
        2)
            echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] User selected Battery Saver" >> "$LOG_FILE"
            sudo ib-power-mode saver
            ;;
        3)
            echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] User selected Balanced" >> "$LOG_FILE"
            sudo ib-power-mode balanced
            ;;
        4)
            echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] User selected Performance" >> "$LOG_FILE"
            sudo ib-power-mode performance
            ;;
        5)
            echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] User selected Maximum Performance" >> "$LOG_FILE"
            sudo ib-power-mode maximum
            ;;
        6)
            echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO] User quit power menu" >> "$LOG_FILE"
            echo "Goodbye!"
            exit 0
            ;;
        *)
            echo "Invalid choice. Press Enter to continue..."
            read -r
            ;;
    esac
    echo ""
    read -r -p "Press Enter to return to menu..."
done